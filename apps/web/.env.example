NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave blank to use the built-in sample catalogue (checkout stays off)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-01
# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Accepted payment methods shown on the site: keep in step with Shopify Settings > Payments (docs/payments.md)
NEXT_PUBLIC_PAYMENT_METHODS=UPI,Cards,Net banking,Wallets,Cash on delivery
# Shown on /contact
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Demo checkout (takes no payment). Only for trying the shop before a store exists. Never set in production.
DEMO_CHECKOUT=
NEXT_PUBLIC_DEMO_CHECKOUT=
