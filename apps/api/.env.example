NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
# Public URL of the storefront, used in emailed links (verify email, reset password, staff invite)
WEB_URL=http://localhost:3000
# Public URL of this API (used to build links to uploaded review photos)
PUBLIC_API_URL=http://localhost:4000
# Local dev: run `npm run dev:db -w @curvefit/api` (no Docker needed).
# Production: MongoDB Atlas, Mumbai region.
MONGODB_URI=mongodb://127.0.0.1:27017/curvefit
# At least 32 characters each. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too

# Shopify Admin API (order lookup, stock, replacement orders). Blank = built-in fake in dev.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01
# Shared secret used to verify webhooks (orders/create, orders/fulfilled)
SHOPIFY_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (template names must match the Template ids in notifier.ts)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_LANG=en
# Email via Resend
RESEND_API_KEY=
EMAIL_FROM=

# Shiprocket reverse pickups. Blank = built-in fake in dev.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Where returned items are sent
WAREHOUSE_NAME=
WAREHOUSE_ADDRESS=
WAREHOUSE_CITY=
WAREHOUSE_STATE=
WAREHOUSE_PINCODE=
WAREHOUSE_PHONE=
WAREHOUSE_EMAIL=

# Review photos. Blank S3_* = local disk (development only). Production needs S3-compatible storage
# (AWS S3, Cloudflare R2, ...). S3_PUBLIC_BASE is the public URL that serves the bucket.
UPLOAD_DIR=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE=

# Slack-compatible incoming webhook: gets a message when the API errors, loses its database,
# or an exchange needs manual follow-up. No customer data is sent.
ALERT_WEBHOOK_URL=
